# ---------------------------------------------------------------------------
# Copy this file to .env and adjust the values before deploying.
# ---------------------------------------------------------------------------

# REQUIRED: generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# "False" in production (only True for local development)
DJANGO_DEBUG=False

# Comma separated list of hostnames the site is served from
DJANGO_ALLOWED_HOSTS=forms.example.com,localhost,127.0.0.1

# Comma separated list of full origins (scheme + host) for POST/CSRF checks.
# Needed when the app sits behind an HTTPS reverse proxy, e.g.:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://forms.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Set to True when you serve the app over HTTPS (secure cookies)
DJANGO_SECURE_COOKIES=False

# Host port published by docker compose
APP_PORT=8000

# Branding
SITE_NAME=Python Form Designer
APP_VERSION=2.0.0

# --- Database --------------------------------------------------------------
# sqlite (default, stored in the /data volume) or postgres
DB_ENGINE=sqlite

# Only used when DB_ENGINE=postgres
DB_NAME=formdesigner
DB_USER=formdesigner
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# --- Optional first admin user (created on container start) ----------------
# The email is optional.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=change-me-too
# DJANGO_SUPERUSER_EMAIL=admin@example.com

# --- Gunicorn tuning -------------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
