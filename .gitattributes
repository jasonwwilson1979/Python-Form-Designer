# Normalise every text file to LF in the repository AND in the working tree.
# (entrypoint.sh with CRLF would fail inside the Linux container.)
* text=auto eol=lf

# Windows-only helpers keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files - never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.sqlite3 binary
*.gz binary
*.zip binary
